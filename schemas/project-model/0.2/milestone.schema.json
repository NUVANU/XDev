{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/project-model/0.2/milestone.schema.json",
  "title": "XDev Milestone 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "milestone_id", "title", "status", "task_ids", "dependencies", "exit_criteria"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "milestone_id": { "$ref": "common.schema.json#/$defs/milestoneId" },
    "title": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "status": { "enum": ["BACKLOG", "PLANNED", "ACTIVE", "PROTOTYPE_READY", "VERIFIED", "BLOCKED"] },
    "task_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/taskId" } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/milestoneId" } },
    "exit_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyText" } }
  }
}
