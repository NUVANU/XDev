{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/project-model/0.2/requirement-registry.schema.json",
  "title": "XDev Requirement Registry 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "requirements", "acceptance_criteria"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "project_id": { "$ref": "common.schema.json#/$defs/projectId" },
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "requirement.schema.json" } },
    "acceptance_criteria": { "type": "array", "items": { "$ref": "acceptance-criterion.schema.json" } }
  }
}
