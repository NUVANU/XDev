{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/project-model/0.1/design-seed.schema.json",
  "title": "XDev Controlled Design Seed 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "owner_policy", "approved_design_refs", "flow", "requirements", "acceptance_criteria", "milestones", "tasks", "owner_gates"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "project_id": { "$ref": "common.schema.json#/$defs/projectId" },
    "name": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "owner_policy": { "enum": ["quality_first", "balanced", "economy"] },
    "approved_design_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reason"],
      "properties": {
        "type": { "enum": ["quick", "full_governance"] },
        "reason": { "$ref": "common.schema.json#/$defs/nonEmptyText" }
      }
    },
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "requirement.schema.json" } },
    "acceptance_criteria": { "type": "array", "items": { "$ref": "acceptance-criterion.schema.json" } },
    "milestones": { "type": "array", "minItems": 1, "items": { "$ref": "milestone.schema.json" } },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "task-contract.schema.json" } },
    "owner_gates": { "type": "array", "items": { "$ref": "owner-gate.schema.json" } }
  }
}
