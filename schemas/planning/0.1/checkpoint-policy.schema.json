{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/planning/0.1/checkpoint-policy.schema.json",
  "title": "XDev Checkpoint Policy 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_digest", "subject_task_id", "subject_task_kind", "subject_repository_access", "critical_boundary_evaluations", "derived_consumer_task_ids", "trigger_reasons", "disposition", "source_decision_id", "source_decision_digest", "effective_at", "rationale"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "policy_id": { "$ref": "common.schema.json#/$defs/checkpointPolicyId" },
    "policy_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "subject_task_id": { "$ref": "common.schema.json#/$defs/taskId" },
    "subject_task_kind": { "$ref": "common.schema.json#/$defs/taskKind" },
    "subject_repository_access": { "$ref": "common.schema.json#/$defs/repositoryAccess" },
    "critical_boundary_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary", "derived_consumer_task_ids"],
        "properties": {
          "boundary": { "$ref": "common.schema.json#/$defs/criticalBoundary" },
          "derived_consumer_task_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/taskId" } }
        }
      }
    },
    "derived_consumer_task_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/taskId" } },
    "trigger_reasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyText" } },
    "checkpoint_task_id": { "$ref": "common.schema.json#/$defs/taskId" },
    "disposition": { "enum": ["required", "exempt_control", "not_required"] },
    "source_decision_id": { "type": "string", "pattern": "^OWNER-DECISION-[0-9]{3,}$" },
    "source_decision_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "effective_at": { "type": "string", "format": "date-time" },
    "rationale": { "$ref": "common.schema.json#/$defs/nonEmptyText" }
  },
  "allOf": [{
    "if": { "properties": { "disposition": { "const": "required" } }, "required": ["disposition"] },
    "then": { "properties": { "checkpoint_task_id": true }, "required": ["checkpoint_task_id"] },
    "else": { "not": { "required": ["checkpoint_task_id"] } }
  }]
}
