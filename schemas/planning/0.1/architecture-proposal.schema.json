{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/planning/0.1/architecture-proposal.schema.json",
  "title": "XDev Architecture Proposal 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture_proposal_id", "project_id", "source_requirement_ids", "summary", "components", "interfaces", "decisions", "risks"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "architecture_proposal_id": { "$ref": "common.schema.json#/$defs/architectureProposalId" },
    "project_id": { "$ref": "common.schema.json#/$defs/projectId" },
    "source_requirement_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/requirementId" } },
    "summary": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "name", "responsibilities", "owned_paths"],
        "properties": {
          "component_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "name": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
          "responsibilities": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyText" } },
          "owned_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/relativePath" } }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interface_id", "name", "version", "producer_component_id", "consumer_component_ids", "contract", "frozen"],
        "properties": {
          "interface_id": { "type": "string", "pattern": "^IF-[A-Z0-9]+(?:-[A-Z0-9]+)+$" },
          "name": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "producer_component_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "consumer_component_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" } },
          "contract": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
          "frozen": { "type": "boolean" }
        }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyText" } },
    "risks": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyText" } }
  }
}
