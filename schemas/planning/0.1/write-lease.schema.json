{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/planning/0.1/write-lease.schema.json",
  "title": "XDev Write Lease 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lease_id", "project_id", "worktree_id", "worktree_identity_version", "canonical_real_path", "filesystem_identity", "fencing_token", "holder_run_id", "allowed_scope", "acquired_at", "expires_at", "status"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "lease_id": { "$ref": "common.schema.json#/$defs/writeLeaseId" },
    "project_id": { "$ref": "common.schema.json#/$defs/projectId" },
    "worktree_id": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "worktree_identity_version": { "const": "0.1" },
    "canonical_real_path": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "filesystem_identity": { "$ref": "common.schema.json#/$defs/nonEmptyText" },
    "fencing_token": { "type": "integer", "minimum": 1 },
    "holder_run_id": { "$ref": "common.schema.json#/$defs/runId" },
    "allowed_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "acquired_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["active", "released", "expired", "orphaned"] }
  }
}
