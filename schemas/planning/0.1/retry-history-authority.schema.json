            "minItems": 0
          }
        },
        "required": [
          "root_task_id",
          "nodes",
          "edges"
        ]
      },
      "minItems": 1
    },
    "fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fingerprint_id": {
            "type": "string",
            "pattern": "^ff-v0\\.1:[0-9a-f]{64}$"
