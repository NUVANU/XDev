{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/planning/0.1/retry-history-authority.schema.json",
  "title": "RetryHistoryAuthority 0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^rha-v0\\.1:[0-9a-f]{64}$"
    },
    "authority_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "root_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root_identity_version": {
          "const": "0.1"
        },
        "repo_root_identity": {
          "type": "string",
          "minLength": 1
        },
        "canonical_root_path_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "project_state_ref": {
          "const": ".xdev/project-state.json"
        },
        "project_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "root_identity_version",
        "repo_root_identity",
        "canonical_root_path_sha256",
        "project_state_ref",
        "project_state_sha256"
      ]
    },
    "source_contract_version": {
      "const": "retry-source-event-0.1"
    },
    "source_paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_state": {
          "const": ".xdev/project-state.json"
        },
        "ledger": {
          "const": ".xdev/task-ledger.jsonl"
        }
      },
      "required": [
        "project_state",
        "ledger"
