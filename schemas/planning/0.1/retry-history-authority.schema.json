              "contract_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "affected_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
