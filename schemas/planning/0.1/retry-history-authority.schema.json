            "required": [
              "schema_version",
              "stage",
              "issue_code",
              "contract_refs",
              "affected_paths",
              "root_cause_class"
            ]
          },
          "canonical_tuple_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "fingerprint_id",
          "fingerprint_ref",
          "fingerprint_sha256",
          "canonical_tuple",
          "canonical_tuple_sha256"
        ]
      },
      "minItems": 0
