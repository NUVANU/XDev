          "type": "null"
        }
      ]
    },
    "lineages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root_task_id": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "task_contract_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "task_contract_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "initial",
                    "rename",
                    "split",
                    "replan",
                    "reassignment"
                  ]
                },
                "source_event_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "task_id",
                "task_contract_ref",
                "task_contract_sha256",
                "origin",
                "source_event_id"
              ]
            },
            "minItems": 1
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "parent_task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "child_task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "rename",
                    "split",
                    "replan",
                    "reassignment"
                  ]
                },
                "source_event_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "parent_task_id",
                "child_task_id",
                "relation",
                "source_event_id"
              ]
