    "snapshot_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_ref": {
          "const": ".xdev/evidence/retry-history-authority-snapshot.json"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
