        "ledger_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ledger_line_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "last_event_id": {
          "type": "string",
          "minLength": 1
        },
        "last_event_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
