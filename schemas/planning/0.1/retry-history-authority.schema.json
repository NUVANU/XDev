  "required": [
    "schema_version",
    "authority_id",
    "authority_digest",
    "project_id",
    "root_binding",
    "source_contract_version",
    "source_paths",
    "snapshot_binding",
    "source_watermark",
    "legacy_transition_binding",
    "lineages",
    "fingerprints",
    "runs",
    "derived_counts",
    "created_at"
  ]
}
