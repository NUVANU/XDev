                  "properties": {
                    "event_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ledger_line": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "event_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "project_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "task_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "dispatch_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attempt_kind": {
                      "type": "string",
                      "enum": [
                        "initial",
                        "automatic_rework",
                        "owner_granted_recovery"
                      ]
                    },
                    "failure_fingerprint_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^ff-v0\\.1:[0-9a-f]{64}$"
