          "owner_granted_recovery_charges": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "all_worker_charges": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
