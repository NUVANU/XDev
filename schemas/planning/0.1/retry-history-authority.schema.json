                    "event_id",
                    "event_type",
                    "ledger_line",
                    "event_sha256",
                    "project_id",
                    "task_id",
                    "run_id",
                    "payload_ref",
                    "payload_sha256",
                    "created_at",
                    "dispatch_id",
                    "attempt_kind",
                    "failure_fingerprint_id"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "run_id",
              "task_id",
              "lineage_root_task_id",
              "terminal_disposition",
              "charge_event_id",
              "source_class",
              "dispatch_id",
              "attempt_kind",
              "failure_fingerprint_id",
              "predecessor_run_id",
              "source_event_refs"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "lineage_root_task_id": {
                "type": "string",
                "minLength": 1
              },
              "terminal_disposition": {
                "type": "string",
                "enum": [
                  "active",
                  "implemented",
                  "failed",
                  "interrupted",
                  "cancelled",
                  "crashed",
                  "unreachable"
                ]
              },
              "charge_event_id": {
                "type": "string",
                "minLength": 1
              },
              "source_class": {
                "const": "legacy"
              },
              "dispatch_id_classification": {
                "const": "UNKNOWN"
              },
              "attempt_kind_classification": {
                "const": "UNKNOWN"
              },
              "failure_fingerprint_classification": {
                "const": "UNKNOWN"
              },
              "legacy_projection_ref": {
                "type": "string",
                "minLength": 1
              },
              "legacy_projection_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_event_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "event_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ledger_line": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "event_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "project_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "task_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "run_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "dispatch_id": {
                      "const": "UNKNOWN"
                    },
                    "attempt_kind": {
                      "const": "UNKNOWN"
                    },
                    "failure_fingerprint_id": {
                      "const": "UNKNOWN"
                    }
                  },
                  "required": [
                    "event_id",
                    "event_type",
                    "ledger_line",
                    "event_sha256",
                    "project_id",
                    "task_id",
                    "run_id",
                    "payload_ref",
                    "payload_sha256",
                    "created_at",
                    "dispatch_id",
                    "attempt_kind",
                    "failure_fingerprint_id"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "run_id",
              "task_id",
              "lineage_root_task_id",
              "terminal_disposition",
              "charge_event_id",
              "source_class",
              "dispatch_id_classification",
              "attempt_kind_classification",
              "failure_fingerprint_classification",
              "legacy_projection_ref",
              "legacy_projection_sha256",
              "source_event_refs"
            ]
          }
        ]
      },
      "minItems": 0
    },
    "derived_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lineage_root_task_id": {
            "type": "string",
            "minLength": 1
          },
          "failure_fingerprint_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ff-v0\\.1:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "automatic_rework_charges": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
