        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projection_ref": {
              "const": ".xdev/diagnostics/M2-T002-STAGE-A-LEGACY-PROJECTION-002.json"
            },
            "projection_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
