              },
              "failure_fingerprint_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^ff-v0\\.1:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "predecessor_run_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
