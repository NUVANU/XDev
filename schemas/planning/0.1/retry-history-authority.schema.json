          "fingerprint_ref": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonical_tuple": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": "0.1"
              },
              "stage": {
                "type": "string",
                "enum": [
                  "planning",
                  "dispatch",
                  "implementation",
                  "checkpoint",
                  "review",
                  "verification",
                  "integration"
