                  "active",
                  "implemented",
                  "failed",
                  "interrupted",
                  "cancelled",
                  "crashed",
                  "unreachable"
                ]
              },
              "charge_event_id": {
                "type": "string",
                "minLength": 1
              },
              "source_class": {
                "const": "current"
              },
              "dispatch_id": {
                "type": "string",
                "minLength": 1
              },
              "attempt_kind": {
                "type": "string",
                "enum": [
                  "initial",
                  "automatic_rework",
                  "owner_granted_recovery"
