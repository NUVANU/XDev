{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/planning/0.1/failure-fingerprint.schema.json",
  "title": "XDev Failure Fingerprint 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fingerprint_id", "stage", "issue_code", "contract_refs", "affected_paths", "root_cause_class"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "fingerprint_id": { "$ref": "common.schema.json#/$defs/failureFingerprintId" },
    "stage": { "enum": ["planning", "dispatch", "implementation", "checkpoint", "review", "verification", "integration"] },
    "issue_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+$" },
    "contract_refs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "affected_paths": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/relativePath" } },
    "root_cause_class": { "enum": ["requirements", "design", "implementation", "test", "environment", "permission", "dependency", "model"] }
  }
}
