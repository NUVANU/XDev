{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/execution-delivery/0.1/checkpoint-result.schema.json",
  "title": "XDev Checkpoint Result 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "policy_id",
    "policy_digest",
    "source_decision_id",
    "source_decision_digest",
    "policy_effective_at",
    "subject_task_id",
    "subject_run_ids",
    "task_contract_digest",
    "artifact_snapshot_id",
    "artifact_snapshot_digest",
    "reviewer_run_id",
    "reviewer_agent_id",
    "reviewer_role_id",
    "outcome",
    "finding_refs",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "result_id": {
      "$ref": "common.schema.json#/$defs/checkpointResultId"
    },
    "policy_id": {
      "$ref": "common.schema.json#/$defs/checkpointPolicyId"
    },
    "policy_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_decision_id": {
      "type": "string",
      "pattern": "^OWNER-DECISION-[0-9]{3,}$"
    },
    "source_decision_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "policy_effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject_task_id": {
      "$ref": "common.schema.json#/$defs/taskId"
    },
    "subject_run_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/runId"
      },
      "uniqueItems": true
    },
    "task_contract_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "artifact_snapshot_id": {
      "$ref": "common.schema.json#/$defs/snapshotId"
    },
    "artifact_snapshot_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "reviewer_run_id": {
      "$ref": "common.schema.json#/$defs/runId"
    },
    "reviewer_agent_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyText"
    },
    "reviewer_role_id": {
      "$ref": "common.schema.json#/$defs/nonEmptyText"
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
