{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/delivery/0.1/delivery-outcome.schema.json",
  "title": "XDev Delivery Outcome 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delivery_outcome_id", "profile_decision_id", "task_id", "status", "gate_result_refs", "evidence_refs", "decided_at"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "delivery_outcome_id": { "$ref": "common.schema.json#/$defs/deliveryOutcomeId" },
    "profile_decision_id": { "$ref": "common.schema.json#/$defs/profileDecisionId" },
    "task_id": { "$ref": "common.schema.json#/$defs/taskId" },
    "status": { "enum": ["PROTOTYPE_UNVERIFIED", "VERIFIED", "REWORK", "BLOCKED"] },
    "gate_result_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
    "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/artifactRef" } },
    "decided_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PROTOTYPE_UNVERIFIED" } }, "required": ["status"] },
      "then": { "properties": { "evidence_refs": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "VERIFIED" } }, "required": ["status"] },
      "then": { "properties": { "gate_result_refs": { "type": "array", "minItems": 1 }, "evidence_refs": { "type": "array", "minItems": 1 } } }
    }
  ]
}
