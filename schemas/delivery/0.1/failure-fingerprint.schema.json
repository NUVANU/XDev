{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/delivery/0.1/failure-fingerprint.schema.json",
  "title": "XDev Failure Fingerprint 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fingerprint_id", "repo_root_identity", "stage", "issue_code", "contract_refs", "affected_paths", "root_cause_class"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "fingerprint_id": { "type": "string", "pattern": "^ff-v0\\.1:[0-9a-f]{64}$" },
    "repo_root_identity": { "type": "string", "pattern": "^wt-v0\\.1:[0-9a-f]{64}$" },
    "stage": { "enum": ["planning", "readiness", "dispatch", "implementation", "checkpoint", "code_review", "qa", "evidence_check", "spec_check", "integration", "recovery"] },
    "issue_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+$" },
    "contract_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyText" } },
    "affected_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/canonicalRepoPath" } },
    "root_cause_class": { "enum": ["model_reasoning", "implementation", "contract", "environment", "permission", "dependency", "test_infrastructure"] }
  }
}
