{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdev.local/schemas/delivery/0.1/closure-manifest.schema.json",
  "title": "XDev Closure Manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "closure_id", "snapshot_id", "snapshot_digest", "gate_run_id", "gate_result", "report_refs", "evidence_refs", "closed_at"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "closure_id": { "type": "string", "pattern": "^CM-[A-Z0-9]+(?:-[A-Z0-9]+)+$" },
    "snapshot_id": { "type": "string", "pattern": "^es-v0\\.1:[0-9a-f]{64}$" },
    "snapshot_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "gate_run_id": { "$ref": "common.schema.json#/$defs/runId" },
    "gate_result": { "enum": ["PASS", "FAIL"] },
    "report_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/canonicalRepoPath" } },
    "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/canonicalRepoPath" } },
    "closed_at": { "type": "string", "format": "date-time" }
  }
}
