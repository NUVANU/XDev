{
  "description": "Conservative XDev reminders for bounded delegation and evidence gates.",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/xdev-governance-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\xdev-governance-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Loading XDev task guardrails",
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/xdev-governance-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\xdev-governance-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Checking XDev evidence gate",
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/xdev-governance-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\xdev-governance-hook.mjs\"",
            "timeout": 3,
            "statusMessage": "Checking XDev evidence gate",
            "additionalContextLimit": 1000
          }
        ]
      }
    ]
  }
}
